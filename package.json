{
  "name": "tajski-poker-online",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/node.mjs",
    "dev": "node server/node.mjs",
    "build": "node scripts/build.mjs",
    "test": "node engine.test.mjs && node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler deploy",
    "db:remote": "wrangler d1 migrations apply tajski-poker --remote",
    "cf:check": "wrangler deploy --dry-run --outdir dist/worker",
    "setup:auth": "node scripts/setup-auth.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.8",
    "drizzle-orm": "0.44.7",
    "esbuild": "0.25.12",
    "jsdom": "^26.1.0",
    "wrangler": "^4.0.0"
  }
}
